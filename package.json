{
  "name": "hana-img-viewer-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev:vue": "pnpm -F hana-img-viewer-demo-vue dev",
    "dev:react": "pnpm -F hana-img-viewer-demo-react dev",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:vue": "pnpm -F hana-img-viewer build",
    "build:react": "pnpm -F hana-img-viewer-react build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -F hana-img-viewer typecheck && pnpm -F hana-img-viewer-react typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:dist": "pnpm -F hana-img-viewer test:dist && pnpm -F hana-img-viewer-react test:dist",
    "release": "pnpm build && changeset publish",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "@types/throttle-debounce": "catalog:",
    "@vitejs/plugin-vue": "catalog:ui-vue",
    "@vue/server-renderer": "catalog:ui-vue",
    "@vue/test-utils": "catalog:ui-vue",
    "cpy": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "fast-glob": "catalog:",
    "jsdom": "catalog:",
    "sass": "catalog:ui-vue",
    "throttle-debounce": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:ui-vue",
    "vue-tsc": "catalog:ui-vue"
  }
}
