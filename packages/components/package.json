{
  "name": "hana-img-viewer",
  "type": "module",
  "version": "3.1.0",
  "description": "A lightweight and easy-to-use image previewer for Vue 3",
  "author": "nonhana",
  "license": "MIT",
  "homepage": "https://github.com/nonhana/hana-img-viewer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nonhana/hana-img-viewer.git"
  },
  "keywords": [
    "image",
    "previewer",
    "vue",
    "component",
    "ssr",
    "nuxt"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "pnpm run test:unit && pnpm run test:component && pnpm run test:ssr",
    "test:unit": "node ./scripts/run-vitest.mjs run --config vitest.unit.config.ts",
    "test:component": "node ./scripts/run-vitest.mjs run --config vitest.component.config.ts",
    "test:ssr": "node ./scripts/run-vitest.mjs run --config vitest.ssr.config.ts",
    "test:dist": "pnpm run build && node ./scripts/run-vitest.mjs run --config vitest.dist.config.ts",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "vite-plugin-dts": "catalog:"
  }
}
