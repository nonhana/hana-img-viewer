{
  "name": "hana-img-viewer-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev:vue": "pnpm -F hana-img-viewer-demo-vue dev",
    "dev:react": "pnpm -F hana-img-viewer-demo-react dev",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:vue": "pnpm -F hana-img-viewer build",
    "build:react": "pnpm -F hana-img-viewer-react build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -F hana-img-viewer typecheck && pnpm -F hana-img-viewer-react typecheck && pnpm run typecheck:contracts",
    "test": "pnpm run test:unit && pnpm run test:contract",
    "test:contract": "pnpm exec vitest run --config vitest.config.ts --project=contract-governance --project=contract-react-dom --project=contract-react-server --project=contract-vue-dom --project=contract-vue-server",
    "test:contract:react": "pnpm exec vitest run --config vitest.config.ts --project=contract-react-dom --project=contract-react-server",
    "test:contract:vue": "pnpm exec vitest run --config vitest.config.ts --project=contract-vue-dom --project=contract-vue-server",
    "test:dist:react": "pnpm run build:react && pnpm exec vitest run --config vitest.config.ts --project=dist-react",
    "test:dist:vue": "pnpm run build:vue && pnpm exec vitest run --config vitest.config.ts --project=dist-vue",
    "test:unit": "pnpm -F hana-img-viewer-core run test && pnpm -F hana-img-viewer run test:unit && pnpm -F hana-img-viewer-react run test:unit",
    "test:dist": "pnpm run test:dist:vue && pnpm run test:dist:react",
    "typecheck:contracts": "tsc -p tests/adapters/react/tsconfig.json --noEmit && vue-tsc -p tests/adapters/vue/tsconfig.json --noEmit",
    "release": "pnpm build && changeset publish",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@testing-library/dom": "catalog:ui-react",
    "@testing-library/react": "catalog:ui-react",
    "@types/node": "catalog:",
    "@types/react": "catalog:ui-react",
    "@types/react-dom": "catalog:ui-react",
    "@types/throttle-debounce": "catalog:",
    "@vitejs/plugin-react": "catalog:ui-react",
    "@vitejs/plugin-vue": "catalog:ui-vue",
    "@vue/server-renderer": "catalog:ui-vue",
    "@vue/test-utils": "catalog:ui-vue",
    "cpy": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "fast-glob": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:ui-react",
    "react-dom": "catalog:ui-react",
    "sass": "catalog:ui-vue",
    "throttle-debounce": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:ui-vue",
    "vue-tsc": "catalog:ui-vue"
  }
}
